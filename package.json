{
  "name": "moon-phase",
  "author": "stubu",
  "version": "1.0.1",
  "description": "Pebble Time 2 watchapp showing tonight's moon phase — name, illumination, and a procedurally drawn disc, computed on-watch.",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shrunyan/pebble-moon-phase"
  },
  "homepage": "https://github.com/shrunyan/pebble-moon-phase",
  "bugs": "https://github.com/shrunyan/pebble-moon-phase/issues",
  "scripts": {
    "build": "pebble build",
    "clean": "pebble clean",
    "rebuild": "pebble clean && pebble build",
    "start": "pebble build && pebble install --emulator emery",
    "install:emulator": "pebble install --emulator emery",
    "install:phone": "bash scripts/install-phone.sh",
    "logs": "pebble logs --emulator emery",
    "screenshot": "mkdir -p screenshots && pebble screenshot --emulator emery screenshots/emery.png",
    "kill": "pebble kill",
    "art": "python3 store/marketing/build_art.py",
    "release": "bash scripts/release.sh"
  },
  "pebble": {
    "displayName": "Moon Phase",
    "uuid": "a005a91f-e252-425e-a8d3-a1c032615991",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": {},
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
